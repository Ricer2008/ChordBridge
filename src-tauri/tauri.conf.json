{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChordBridge",
  "version": "0.1.0",
  "identifier": "com.ranlian.chordbridge",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "ChordBridge — 吉他谱多维度转换与预览",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    }
  }
}
